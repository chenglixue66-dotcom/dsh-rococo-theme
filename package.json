{
  "name": "dsh-rococo-theme",
  "version": "0.8.8",
  "description": "洛可可风主题插件：把 DeepSeek Harness 的界面换成凡尔赛沙龙风格（雾蓝、银蓝与奶白）。A Rococo theme plugin for the DSH Web GUI — misty blue, silver and ivory.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "assets/icon-512.png",
  "author": "chenglixue66-dotcom",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenglixue66-dotcom/dsh-rococo-theme.git"
  },
  "homepage": "https://github.com/chenglixue66-dotcom/dsh-rococo-theme#readme",
  "bugs": {
    "url": "https://github.com/chenglixue66-dotcom/dsh-rococo-theme/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "theme",
    "rococo",
    "web-gui"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets",
    "screenshots.json"
  ]
}
